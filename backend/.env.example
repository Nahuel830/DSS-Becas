# Puerto del backend
PORT=3001
# SQLite local. Para MySQL/PostgreSQL: cambiar provider en schema.prisma y usar, p. ej.,
# DATABASE_URL="mysql://usuario:clave@localhost:3306/dss_becas"
DATABASE_URL="file:./dev.db"
CORS_ORIGIN=http://localhost:5173
# Acepta orígenes de la red local (localhost, 127.0.0.1, 192.168.*.*, 10.*.*.*).
# true por defecto en desarrollo, false en producción salvo valor explícito.
CORS_LAN=true
JWT_SECRET=cambiar-en-produccion
UPLOAD_DIR=uploads
